// designed for presenting Vanilla Linux
// inspired from imstilllearnin's Vanilla Logo Ultra
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "color": { "1": "red", "2": "white" },
  },
  "display": {
    "color": {
      "keys": "red",
    },
    "separator": "",
    "percent": {
      "color": {
        "green": "38;2;100;110;150",
        "yellow": "38;2;88;88;133",
        "red": "38;2;100;10;120",
      },
    },
  },
  "modules": [
    {
      "type": "kernel",
      "key": " [_Kernel___> ",
    },
    {
      "type": "packages",
      "key": " [_Packages_> ",
    },
    {
      "type": "localip",
      "key": " [_Local_IP_> ",
    },
    {
      "type": "memory",
      "format": "[{3}] {1} / {2}",
      "key": " [_RAM______> ",
    },
    {
      "type": "swap",
      "format": "[{3}] {1} / {2}",
      "key": " [_SWAP_____> ",
    },
    {
      "type": "disk",
      "format": "[{3}] {1} / {2} {9}",
      "key": " [_Disk_____> ",
    },
    {
      "type": "battery",
      "format": "[{4}] {5}",
      "key": " [_Battery__> ",
    },
  ],
}
